# https://www.talos.dev/v1.10/reference/configuration/v1alpha1/config/
machine:
  network:
    interfaces:
      - deviceSelector:
%{ if mac_address != null }
          hardwareAddr: ${mac_address}
%{ else }
          busPath: "0*" # should select any hardware network device, if you have just one
                        # otherwise mac_address is a must
%{ endif }
        addresses:
          - ${ip}/${subnet_mask}
        routes:
          - network: 0.0.0.0/0
            gateway: ${gateway}
        dhcp: false
%{ if vip != null }
        vip:
          ip: ${vip}
%{ endif }

cluster:
%{ if !talos_1_14_plus }
  allowSchedulingOnControlPlanes: ${allow_scheduling}
%{ if api_server != null }
  apiServer:
    ${indent(4, api_server)}
%{ endif }
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
  scheduler:
    extraArgs:
      bind-address: 0.0.0.0
  network:
    cni:
      name: none
  proxy:
    disabled: true
%{ endif }
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
  extraManifests: ${extra_manifests}
  inlineManifests: ${inline_manifests}

%{ if talos_1_14_plus }
# Talos 1.14+: apiServer/controllerManager/scheduler/proxy content moved to the dedicated
# documents below (see docs/talos-compatibility.md).
#
# allowSchedulingOnControlPlanes moved too: the control-plane NoSchedule taint is now removed via
# a KubeNodeConfig `$patch: delete` on the taint itself, instead of a cluster-level toggle. See
# https://docs.siderolabs.com/talos/v1.14/deploy-and-manage-workloads/workloads-on-controlplane.
%{ if allow_scheduling }
---
apiVersion: v1alpha1
kind: KubeNodeConfig
taints:
  node-role.kubernetes.io/control-plane:
    $patch: delete
%{ endif }
# The base-generated config always includes a default KubeFlannelCNIConfig for 1.14+, regardless
# of settings elsewhere - there's no "disabled" field on it (unlike KubeProxyConfig below), so the
# only way to actually drop the default CNI (this module installs Cilium instead) is to delete the
# document outright. Verified this also requires cleaning up the Flannel DaemonSet/RBAC Talos
# already deployed once at initial bootstrap on a cluster that was bootstrapped before this fix -
# the config change alone only prevents it going forward. See
# https://redirect.github.com/siderolabs/talos/issues/13958 and
# https://redirect.github.com/siderolabs/talos/issues/14398.
---
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete

---
apiVersion: v1alpha1
kind: KubeAPIServerConfig
image: registry.k8s.io/kube-apiserver:${kubernetes_version}
%{ if api_server_config_yaml != null }
${api_server_config_yaml}
%{ endif }

---
apiVersion: v1alpha1
kind: KubeControllerManagerConfig
image: registry.k8s.io/kube-controller-manager:${kubernetes_version}
extraArgs:
  bind-address: 0.0.0.0

---
apiVersion: v1alpha1
kind: KubeSchedulerConfig
image: registry.k8s.io/kube-scheduler:${kubernetes_version}
extraArgs:
  bind-address: 0.0.0.0

---
apiVersion: v1alpha1
kind: KubeProxyConfig
image: registry.k8s.io/kube-proxy:${kubernetes_version}
enabled: false
%{ endif }

# iterate over `disk`-type volumes
%{ for k, v in talos_disk_volumes } 
%{ if v.machine_type == "controlplane" || v.machine_type == "all" }
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: ${k}
volumeType: disk
provisioning:
  diskSelector:
    # https://docs.siderolabs.com/talos/v1.12/configure-your-talos-cluster/storage-and-disk-management/disk-management/common#disk-selector
    # use disk size in GB as pure number w/o UoM, as unsigned INT and append `GiB`
    match: disk.size == ${v.size_gb}u * GiB
%{ endif }  # v.machine_type "controlplane || all"
%{ endfor }

# iterate over `directory`-type volumes
%{ for k, v in talos_volumes } 
%{ if v.type == "directory" && (v.machine_type == "controlplane" || v.machine_type == "all") }
---
apiVersion: v1alpha1
kind: UserVolumeConfig
name: ${k}
volumeType: ${v.type}
%{ endif }  # v.machine_type "controlplane || all"
%{ endfor }
